#!/bin/sh
# Raman workflow: MB-alpha polarizabilities (1B + 2B + NB) -> depolarized and
# isotropic responses -> spectra.
. "${srcdir:-$(dirname "$0")}/common.sh"

sed 's/"depolarized"/"isotropic"/' "$data/raman.json" > raman-iso.json

run polarizability.dat "$(prog raman polarizability)" "$data/water4.xyz" "$data/raman.json"
run response.dat       "$(prog raman response)" polarizability.dat "$data/raman.json"
run spectrum.dat       "$(prog raman spectrum)" response.dat       "$data/raman.json"
run response-iso.dat   "$(prog raman response)" polarizability.dat raman-iso.json
run spectrum-iso.dat   "$(prog raman spectrum)" response-iso.dat   raman-iso.json
check polarizability.dat response.dat spectrum.dat response-iso.dat spectrum-iso.dat
finish
